            <mxPoint x="370" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-10" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.583;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="QSUni-jMyAJnOjuoWNwQ-1" target="QSUni-jMyAJnOjuoWNwQ-2">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="450" y="380" as="sourcePoint" />
            <mxPoint x="370" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-11" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Гибкость состояния нереляционных баз данных прекрасно сочетается с&amp;nbsp;обработкой временных рядов, особенно в&amp;nbsp;проектах, в&amp;nbsp;которых &lt;/font&gt;&lt;/span&gt;&lt;u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;text-decoration:underline;text-underline:single;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;скорость сбора данных и&amp;nbsp;количество входных каналов могут изменяться&lt;/font&gt;&lt;/span&gt;&lt;/u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&amp;nbsp;&lt;font face=&quot;Times New Roman&quot;&gt;в&amp;nbsp;течение всего срока хранения набора данных.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="430" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-12" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.69;exitY=0.993;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="QSUni-jMyAJnOjuoWNwQ-1" target="QSUni-jMyAJnOjuoWNwQ-11">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="510" y="590" as="sourcePoint" />
            <mxPoint x="560" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-13" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Например, временной ряд может изначально включать всего один канал данных, но постепенно расширяться за счёт включения большего количества типов данных, снабжённых временной разметкой.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="540" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-14" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="QSUni-jMyAJnOjuoWNwQ-11" target="QSUni-jMyAJnOjuoWNwQ-13">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="800" y="590" as="sourcePoint" />
            <mxPoint x="850" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-15" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;В&amp;nbsp;дальнейшем, ввиду бесполезности, &lt;/font&gt;&lt;/span&gt;&lt;i&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-style:italic;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;некоторые из входных каналов всегда можно отключить&lt;/font&gt;&lt;/span&gt;&lt;/i&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="630" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-16" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="QSUni-jMyAJnOjuoWNwQ-13" target="QSUni-jMyAJnOjuoWNwQ-15">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="800" y="590" as="sourcePoint" />
            <mxPoint x="850" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-17" value="&lt;p style=&quot;margin-left:0,0000pt;mso-para-margin-left:0,0000gd;text-indent:42,5000pt;&#xa;mso-char-indent-count:0,0000;text-autospace:ideograph-numeric;mso-pagination:widow-orphan;&#xa;text-align:justify;text-justify:inter-ideograph;&quot; align=&quot;justify&quot; class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Сохранение подобных данных в&amp;nbsp;реляционной таблице представляет собой трудно решаемую задачу сразу по&amp;nbsp;нескольким причинам и&amp;nbsp;приводит к&amp;nbsp;включению большого количества значений NaN, указывающих на&amp;nbsp;недоступность данных. &lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:SimSun;font-size:12,0000pt;&quot;&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="620" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-18" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.368;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="QSUni-jMyAJnOjuoWNwQ-13" target="QSUni-jMyAJnOjuoWNwQ-17">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="870" y="590" as="sourcePoint" />
            <mxPoint x="920" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="QSUni-jMyAJnOjuoWNwQ-19" target="QSUni-jMyAJnOjuoWNwQ-20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-19" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;font-weight:bold;text-transform:none;&#xa;font-style:normal;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;прогнозирование: модель на цепях Маркова (Markov Chains)&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8099FF;" vertex="1" parent="1">
          <mxGeometry x="-342" y="320" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.451;entryY=0.017;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="QSUni-jMyAJnOjuoWNwQ-20" target="QSUni-jMyAJnOjuoWNwQ-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-20" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Рассмотрим ц&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;епи Маркова с конечным или счётным пространством состояний.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-355" y="440" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="QSUni-jMyAJnOjuoWNwQ-21" target="QSUni-jMyAJnOjuoWNwQ-22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-21" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;text-decoration:underline;&#xa;text-underline:single;font-style:normal;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;М&lt;/font&gt;&lt;/span&gt;&lt;/u&gt;&lt;u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;text-decoration:underline;&#xa;text-underline:single;font-style:normal;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;арковское свойство&lt;/font&gt;&lt;/span&gt;&lt;/u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&amp;nbsp;&lt;font face=&quot;Times New Roman&quot;&gt;сообщает, что если известно значение, полученное каким-то случайным процессом в заданный момент врем&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;ени условное распределение будущих состояний процесса с заданными текущим и прошлыми состояниями зависит только от текущего состояния, но не от прошлых состоян&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;ий (свойство отсутствия памяти).&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-402" y="550" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.446;entryY=0.01;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="QSUni-jMyAJnOjuoWNwQ-22" target="QSUni-jMyAJnOjuoWNwQ-23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-22" value="&lt;p style=&quot;margin-left:0,0000pt;mso-para-margin-left:0,0000gd;text-indent:42,5000pt;&#xa;mso-char-indent-count:0,0000;text-autospace:ideograph-numeric;mso-pagination:widow-orphan;&#xa;text-align:justify;text-justify:inter-ideograph;&quot; align=&quot;justify&quot; class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Случайный процесс с марковским свойством называется &lt;/font&gt;&lt;/span&gt;&lt;u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;text-decoration:underline;&#xa;text-underline:single;font-style:normal;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;марковским процессом&lt;/font&gt;&lt;/span&gt;&lt;/u&gt;&lt;u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;text-decoration:underline;&#xa;text-underline:single;font-style:normal;font-size:14,0000pt;&quot;&gt;.&lt;/span&gt;&lt;/u&gt;&lt;u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;text-decoration:underline;&#xa;text-underline:single;font-style:normal;font-size:14,0000pt;&quot;&gt;&lt;/span&gt;&lt;/u&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-352" y="690" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="QSUni-jMyAJnOjuoWNwQ-23">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-237" y="960" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-23" value="&lt;p style=&quot;margin-left:0,0000pt;mso-para-margin-left:0,0000gd;text-indent:42,5000pt;&#xa;mso-char-indent-count:0,0000;text-autospace:ideograph-numeric;mso-pagination:widow-orphan;&#xa;text-align:justify;text-justify:inter-ideograph;&quot; align=&quot;justify&quot; class=&quot;MsoNormal&quot;&gt;&lt;u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;text-decoration:underline;&#xa;text-underline:single;font-style:normal;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Цепь Маркова&lt;/font&gt;&lt;/span&gt;&lt;/u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&amp;nbsp;&lt;font face=&quot;Times New Roman&quot;&gt;— это марковский процесс с дискретным временем и дискретным пространством состояний&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;, то есть&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&amp;nbsp;&lt;font face=&quot;Times New Roman&quot;&gt;это дискретная последовательность состояний, каждое из которых берется из дискретного пространства состояний (конечного или бесконечного), удовлетворяющее марковскому свойству.&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-382" y="810" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-24" value="&lt;p style=&quot;margin-left:0,0000pt;mso-para-margin-left:0,0000gd;text-indent:42,5000pt;&#xa;mso-char-indent-count:0,0000;text-autospace:ideograph-numeric;mso-pagination:widow-orphan;&#xa;text-align:justify;text-justify:inter-ideograph;&quot; align=&quot;justify&quot; class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Для расчёта динамики цепи,&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;необходимо лишь два аспекта: &lt;/font&gt;&lt;/span&gt;&lt;u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;text-decoration:underline;&#xa;text-underline:single;font-style:normal;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;исходное распределение вероятностей&lt;/font&gt;&lt;/span&gt;&lt;/u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&amp;nbsp;&lt;font face=&quot;Times New Roman&quot;&gt;и матрица переходных состояний. &lt;/font&gt;&lt;/span&gt;&lt;u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;text-decoration:underline;&#xa;text-underline:single;font-style:normal;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Матрица переходных вероятностей&lt;/font&gt;&lt;/span&gt;&lt;/u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&amp;nbsp;&lt;font face=&quot;Times New Roman&quot;&gt;— вероятности того, что состояние на следующем шаге является последующим для другого состояния на текущий момент для любой пары состояний&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;. &lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-392" y="960" width="310" height="150" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="QSUni-jMyAJnOjuoWNwQ-29" target="QSUni-jMyAJnOjuoWNwQ-34">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-29" value="&lt;p style=&quot;margin-left:0,0000pt;mso-para-margin-left:0,0000gd;text-indent:42,5000pt;&#xa;mso-char-indent-count:0,0000;text-autospace:ideograph-numeric;mso-pagination:widow-orphan;&#xa;text-align:justify;text-justify:inter-ideograph;&quot; align=&quot;justify&quot; class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;font-weight:bold;text-transform:none;&#xa;font-style:normal;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;прогнозирование: &lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;b&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;font-weight:bold;text-transform:none;&#xa;font-style:normal;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;модель на опорных векторах (SVM)&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;b&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;font-weight:bold;text-transform:none;&#xa;font-style:normal;font-size:14,0000pt;&quot;&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8099FF;" vertex="1" parent="1">
          <mxGeometry x="1270" y="180" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-30" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="-110" y="934" width="410.7" height="200" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-25" value="" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFCCE6;" vertex="1" parent="QSUni-jMyAJnOjuoWNwQ-30">
          <mxGeometry x="54" width="330" height="200" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-26" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="QSUni-jMyAJnOjuoWNwQ-30">
          <mxGeometry x="83.58" y="64.58" width="270.84" height="70.84" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-31" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&lt;br/&gt;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&lt;br/&gt;font-size:14,0000pt;&quot;&gt;В&amp;nbsp;&lt;font face=&quot;Times New Roman&quot;&gt;основу метода положена классификация, производимая за счет перевода исходных временных рядов, представленных в виде векторов, в пространство более высокой размерности и поиска разделяющей гиперплоскости с максимальным зазором в этом пространстве.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="280" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-32" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Алгоритм SVM работает в предположении, что чем больше разница или расстояние между этими параллельными гиперплоскостями, тем меньше будет средняя ошибка.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="430" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-33" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;При этом задача прогнозирования решается таким образом, что на этапе обучения классификатора выявляются независимые переменные (внешние факторы), будущие значения которых определяют в какой из определенных ранее подклассов попадет прогноз Z &lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;t&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;).&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="555" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-34" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;За последние несколько десятилетий разработано множество различных алгоритмов прогнозирования с использованием метода опорных векторов SVM.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1500" y="280" width="160" height="110" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="QSUni-jMyAJnOjuoWNwQ-35" target="QSUni-jMyAJnOjuoWNwQ-36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="QSUni-jMyAJnOjuoWNwQ-35" target="QSUni-jMyAJnOjuoWNwQ-37">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-35" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Рассмотрим некоторые методы, считающиеся наиболее эффективными&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1520" y="420" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-36" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;LS-SVM прогнозирует путем решения системы линейных уравнений.&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1470" y="525" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.627;entryY=0.04;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="QSUni-jMyAJnOjuoWNwQ-37" target="QSUni-jMyAJnOjuoWNwQ-38">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="QSUni-jMyAJnOjuoWNwQ-37" target="QSUni-jMyAJnOjuoWNwQ-39">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-37" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;DLS-SVM является модифицированной версией LS-SVM и подходит для распознавания систем реального времени и прогнозирования временных рядов.&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1610" y="520" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-38" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;В ней используется аналогичный подход, но другой метод вычисления. &lt;/font&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1580" y="660" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-39" value="&lt;p style=&quot;margin-left:0,0000pt;mso-para-margin-left:0,0000gd;text-indent:42,5000pt;&#xa;mso-char-indent-count:0,0000;text-autospace:ideograph-numeric;mso-pagination:widow-orphan;&#xa;text-align:justify;text-justify:inter-ideograph;&quot; align=&quot;justify&quot; class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Ключевой особенностью является способность отслеживать динамику нелинейных систем, изменяющихся во времени.&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;text-transform:none;font-style:normal;&#xa;font-size:14,0000pt;&quot;&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
