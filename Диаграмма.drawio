<mxfile host="Electron" modified="2023-10-08T04:01:34.985Z" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/21.7.5 Chrome/114.0.5735.289 Electron/25.8.1 Safari/537.36" etag="mA5PEImaz94elP7awSS1" version="21.7.5" type="device">
  <diagram name="Страница — 1" id="nJ0O0An66e6yb37WTpe4">
    <mxGraphModel dx="1348" dy="613" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-1" value="&lt;p style=&quot;margin-left:0,0000pt;mso-para-margin-left:0,0000gd;text-indent:42,5000pt;&#xa;mso-char-indent-count:0,0000;text-autospace:ideograph-numeric;mso-pagination:widow-orphan;&#xa;text-align:justify;text-justify:inter-ideograph;&quot; align=&quot;justify&quot; class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;font-weight:bold;text-transform:none;&#xa;font-style:normal;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;хранение: нереляционные базы данных&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;b&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:&#39;Segoe UI&#39;;&#xa;letter-spacing:0,0000pt;font-weight:bold;text-transform:none;&#xa;font-style:normal;font-size:14,0000pt;&quot;&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8099FF;" vertex="1" parent="1">
          <mxGeometry x="410" y="290" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-2" value="&lt;p style=&quot;margin-left:0,0000pt;mso-para-margin-left:0,0000gd;text-indent:42,5000pt;&#xa;mso-char-indent-count:0,0000;text-autospace:ideograph-numeric;mso-pagination:widow-orphan;&#xa;text-align:justify;text-justify:inter-ideograph;&quot; align=&quot;justify&quot; class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;В NoSQL системах отдельного уровня API не предусмотрено, поэтому можно описать модель, определяющую тот формат, в котором приложение будет записывать данные, таким образом никаких &lt;/font&gt;&lt;/span&gt;&lt;i&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-style:italic;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;преобразований схем&lt;/font&gt;&lt;/span&gt;&lt;/i&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&amp;nbsp;(как в реляционной модели) не требуется, а значит с&lt;/span&gt;&lt;u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;text-decoration:underline;text-underline:single;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;корость поступления данных&lt;/font&gt;&lt;/span&gt;&lt;/u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&amp;nbsp;&lt;font face=&quot;Times New Roman&quot;&gt;в NoSQL системах выше.&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="480" width="190" height="190" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-4" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;В вариациях &lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;NoSQL &lt;/span&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;систем схемы описания данных различаются, за счёт этого есть возможность применить &lt;/font&gt;&lt;/span&gt;&lt;u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;text-decoration:underline;text-underline:single;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;разнообразные оптимизации&lt;/font&gt;&lt;/span&gt;&lt;/u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-20" y="540" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-5" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;В OpenTSDB за счёт &lt;/font&gt;&lt;/span&gt;&lt;i&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-style:italic;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;введения тегов и упорядочивания значений&lt;/font&gt;&lt;/span&gt;&lt;/i&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&amp;nbsp;&lt;font face=&quot;Times New Roman&quot;&gt;для каждого тега обеспечивается быстрая &lt;/font&gt;&lt;/span&gt;&lt;u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;text-decoration:underline;text-underline:single;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;агрегация данных&lt;/font&gt;&lt;/span&gt;&lt;/u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-20" y="640" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-6" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;В Cassandra возможно хранить до &lt;/font&gt;&lt;/span&gt;&lt;u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;text-decoration:underline;text-underline:single;font-size:14,0000pt;&quot;&gt;2 миллиардов столбцов в одной строке&lt;/span&gt;&lt;/u&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&amp;nbsp;&lt;font face=&quot;Times New Roman&quot;&gt;благодаря системе с хранением данных &lt;/font&gt;&lt;/span&gt;&lt;i&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-style:italic;font-size:14,0000pt;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;по столбцам&lt;/font&gt;&lt;/span&gt;&lt;/i&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:SimSun;&#xa;font-size:14,0000pt;&quot;&gt;&amp;nbsp;(ключ для строки – имя для измерения, имя столбца – время измерения, значение столбца – измеренное значение).&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="750" width="430" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QSUni-jMyAJnOjuoWNwQ-7" value="" style="endArrow=classic;html=1;rounded=0;entryX=0.571;entryY=0.027;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" target="QSUni-jMyAJnOjuoWNwQ-5">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
